# ---------------------------------------------------------------------------
#  Copy to .env and adjust.  Never commit the real .env file.
# ---------------------------------------------------------------------------

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
PORT=5000

# Database  (SQLite by default; use PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/psa

# Breach service
HIBP_TIMEOUT=4
RANGE_CACHE_TTL=900

# Default administrator created by `python seed.py`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@analyser.local
